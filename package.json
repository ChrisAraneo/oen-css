{
  "name": "@chris.araneo/oen-css",
  "version": "0.2.0",
  "description": "Oen CSS is a CSS framework built from Bulma 1.0.4",
  "keywords": [
    "css",
    "css-framework",
    "bulma",
    "oen",
    "scss",
    "sass",
    "design-system",
    "custom-properties",
    "storybook"
  ],
  "homepage": "https://github.com/ChrisAraneo/oen-css#readme",
  "bugs": {
    "url": "https://github.com/ChrisAraneo/oen-css/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisAraneo/oen-css.git"
  },
  "license": "MIT",
  "author": "Krzysztof Pająk <chris.araneo@gmail.com> (Chris Araneo)",
  "type": "module",
  "exports": {
    ".": "./dist/oen.css",
    "./oen.css": "./dist/oen.css",
    "./oen.min.css": "./dist/oen.min.css",
    "./dist/oen.css": "./dist/oen.css",
    "./dist/oen.min.css": "./dist/oen.min.css",
    "./package.json": "./package.json"
  },
  "main": "dist/oen.css",
  "style": "dist/oen.css",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:css && npm run verify",
    "build:css": "node scripts/build.ts",
    "build:css:watch": "node scripts/build.ts --watch",
    "build:storybook": "npm run build && storybook build --output-dir storybook-static",
    "check": "npm run format:check && npm run typecheck && npm run build && npm run check:stories",
    "check:stories": "node scripts/check-stories.ts",
    "clean": "node scripts/clean.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "storybook": "npm run build && storybook dev -p 6006",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.ts"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/html-vite": "^10.6.7",
    "@types/clean-css": "^4.2.11",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/ramda": "^0.30.2",
    "bulma": "1.0.4",
    "clean-css": "^5.3.3",
    "lodash-es": "^4.18.1",
    "prettier": "^3.10.1",
    "ramda": "^0.30.1",
    "remeda": "^2.26.0",
    "sass": "^1.108.2",
    "storybook": "^10.6.7",
    "ts-pattern": "^5.6.2",
    "typescript": "^7.0.2",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "oen": {
    "bulmaVersion": "1.0.4",
    "cssVariablePrefix": "--oen-"
  }
}
