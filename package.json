{
  "name": "@chris.araneo/oen-css",
  "version": "0.2.1",
  "description": "Oen CSS is a CSS framework built from Bulma 1.0.4",
  "keywords": [
    "css",
    "css-framework",
    "bulma",
    "oen",
    "scss",
    "sass",
    "design-system",
    "custom-properties",
    "storybook"
  ],
  "homepage": "https://github.com/ChrisAraneo/oen-css#readme",
  "bugs": {
    "url": "https://github.com/ChrisAraneo/oen-css/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisAraneo/oen-css.git"
  },
  "license": "MIT",
  "author": "Krzysztof Pająk <chris.araneo@gmail.com> (Chris Araneo)",
  "type": "module",
  "exports": {
    ".": "./oen.css",
    "./oen.css": "./oen.css",
    "./oen.min.css": "./oen.min.css",
    "./package.json": "./package.json"
  },
  "main": "oen.css",
  "style": "oen.css",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "LICENSE",
    "LICENSE-bulma",
    "oen.css",
    "oen.min.css",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "build:watch": "node scripts/build.ts --watch",
    "check": "node scripts/check.ts",
    "check:stories": "node scripts/check.ts --stories",
    "clean": "node scripts/clean.ts",
    "format": "node scripts/format.ts",
    "format:check": "node scripts/format.ts --check",
    "prepack": "npm run build && npm run verify",
    "prepublishOnly": "npm run check",
    "storybook": "node scripts/storybook.ts",
    "storybook:build": "node scripts/storybook.ts --build",
    "test": "node scripts/check.ts --test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "node scripts/check.ts --types",
    "verify": "node scripts/verify.ts"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/html-vite": "^10.6.7",
    "@types/clean-css": "^4.2.11",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/ramda": "^0.30.2",
    "@vitest/coverage-v8": "^5.1.1",
    "bulma": "1.0.4",
    "clean-css": "^5.3.3",
    "lodash-es": "^4.18.1",
    "prettier": "^3.10.1",
    "ramda": "^0.30.1",
    "remeda": "^2.26.0",
    "sass": "^1.108.2",
    "storybook": "^10.6.7",
    "ts-pattern": "^5.6.2",
    "typescript": "^7.0.2",
    "vite": "^7.2.4",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "oen": {
    "bulmaVersion": "1.0.4",
    "cssVariablePrefix": "--oen-"
  }
}
